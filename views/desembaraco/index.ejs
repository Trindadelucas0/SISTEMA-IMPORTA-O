<%- include('../partials/header') %>

<section class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="brand text-3xl font-bold">Desembaraço</h1>
    <p class="mt-1 text-[#4a5560]">Selecione o pedido para digitar os campos amarelos e ver o cálculo automático.</p>
  </div>
</section>

<% if (!pedidos.length) { %>
  <p class="rounded-lg border border-dashed border-[#d4cfc3] bg-white/50 p-6 text-[#4a5560]">Crie um pedido antes de abrir o desembaraço.</p>
<% } else { %>
  <div class="overflow-x-auto rounded-lg border border-[#d4cfc3] bg-white/70">
    <table class="w-full text-left text-sm">
      <thead class="bg-[#1a2332] text-white">
        <tr>
          <th class="px-3 py-2">Código</th>
          <th class="px-3 py-2">Status</th>
          <th class="px-3 py-2">Itens</th>
          <th class="px-3 py-2">Invoice USD</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach(function(p) { %>
          <tr class="border-t border-[#d4cfc3]">
            <td class="px-3 py-2 font-semibold"><%= p.codigo %></td>
            <td class="px-3 py-2"><%= p.status %></td>
            <td class="px-3 py-2"><%= p.qtd_itens %></td>
            <td class="px-3 py-2"><%= moneyUsd(p.total_usd) %></td>
            <td class="px-3 py-2 text-right">
              <a href="/desembaraco/<%= p.id %>" class="btn btn-primary">Abrir planilha</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
