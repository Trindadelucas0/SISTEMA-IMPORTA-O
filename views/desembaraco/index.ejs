<%- include('../partials/header') %>

<section class="page-header mb-4 flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="page-eyebrow">Operação</p>
    <h1 class="page-title">Compras</h1>
    <p class="page-sub">Selecione o pedido para digitar os campos amarelos e recalcular impostos.</p>
  </div>
</section>

<% if (!pedidos.length) { %>
  <p class="empty-state">Crie um pedido antes de abrir o desembaraço.</p>
<% } else { %>
  <div class="panel">
    <div class="panel-head">
      <h2>Pedidos para desembaraçar</h2>
      <span class="badge badge-info"><%= pedidos.length %> pedido(s)</span>
    </div>
    <div class="table-panel" style="border:0;border-radius:0">
      <table>
        <thead>
          <tr>
            <th>Código</th>
            <th>Status</th>
            <th class="col-hide-sm">Itens</th>
            <th>Invoice USD</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% pedidos.forEach(function(p) { %>
            <tr>
              <td class="font-semibold mono"><%= p.codigo %></td>
              <td><%- include('../partials/status-pedido', { pedidoId: p.id, status: p.status }) %></td>
              <td class="num col-hide-sm"><%= p.qtd_itens %></td>
              <td class="num"><%= moneyUsd(p.total_usd) %></td>
              <td class="text-right">
                <a href="/desembaraco/<%= p.id %>" class="btn btn-primary btn-sm">Abrir planilha</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
