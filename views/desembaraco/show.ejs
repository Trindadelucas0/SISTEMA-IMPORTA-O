<%- include('../partials/header') %>

<%
  const invoice = Number(saldo.invoice_usd) || 0;
  const alocado = Number(saldo.alocado_usd) || 0;
  const falta = Number(saldo.falta_usd) || 0;
  const coberturaPct = invoice > 0
    ? Math.min(100, Math.round((alocado / invoice) * 1000) / 10)
    : (saldo.coberto ? 100 : 0);
  const badgeClass = saldo.coberto ? 'badge-ok' : (alocado > 0 ? 'badge-warn' : 'badge-danger');
%>

<section class="page-header mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="page-eyebrow">Desembaraço</p>
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="page-title mono"><%= pedido.codigo %></h1>
      <span class="badge <%= badgeClass %>"><%= saldo.coberto ? 'coberto' : 'pendente' %></span>
      <span class="badge"><%= pedido.status %></span>
    </div>
    <p class="page-sub">
      Amarelo = digitação manual (base J e custo L).
      Custo unitário só com pedido coberto no saldo.
    </p>
  </div>
  <div class="toolbar">
    <a href="/saldo" class="btn btn-ghost btn-sm">Saldo</a>
    <a href="/pedidos/<%= pedido.id %>" class="btn btn-ghost btn-sm">Voltar ao pedido</a>
  </div>
</section>

<% if (saved) { %>
  <p class="alert alert-success" role="status">Desembaraço salvo e recalculado.</p>
<% } %>

<% if (!saldo.coberto) { %>
  <p class="alert alert-warn" role="status">
    Pedido não quitado no saldo (falta <%= moneyUsd(saldo.falta_usd) %>).
    Aloque pagamentos em <a class="link-action underline font-semibold" href="/saldo">Saldo</a> antes de fechar o custo.
  </p>
<% } %>

<section class="coverage-block mb-4">
  <div class="mb-2 flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="stat-label">Cobertura do invoice</p>
      <p class="mono mt-1 text-lg font-semibold"><%= coberturaPct %>%</p>
    </div>
    <p class="stat-meta mono">
      Alocado <%= moneyUsd(alocado) %> · Falta <%= moneyUsd(falta) %> · Invoice <%= moneyUsd(invoice) %>
    </p>
  </div>
  <div class="progress <%= saldo.coberto ? 'progress-ok' : (coberturaPct > 0 ? 'progress-warn' : '') %>">
    <span style="width: <%= coberturaPct %>%"></span>
  </div>
</section>

<section class="kpi-grid mb-4">
  <div class="stat">
    <p class="stat-label">Invoice</p>
    <p class="stat-value"><%= moneyUsd(saldo.invoice_usd) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Alocado</p>
    <p class="stat-value"><%= moneyUsd(saldo.alocado_usd) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Falta</p>
    <p class="stat-value <%= saldo.falta_usd > 0 ? 'text-bad' : 'text-ok' %>"><%= moneyUsd(saldo.falta_usd) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Custo produto (alocações)</p>
    <p class="stat-value"><%= saldo.coberto ? moneyBrl(custoProdutoBrl) : '—' %></p>
  </div>
  <% if (custoDelta) { %>
    <div class="stat">
      <p class="stat-label">Variação do custo</p>
      <% if (custoDelta.aumentou) { %>
        <p class="stat-value text-bad">+ <%= moneyBrl(custoDelta.delta) %></p>
      <% } else if (custoDelta.diminuiu) { %>
        <p class="stat-value text-ok">− <%= moneyBrl(Math.abs(custoDelta.delta)) %></p>
      <% } else { %>
        <p class="stat-value">Sem variação</p>
      <% } %>
      <p class="stat-meta mono">Anterior <%= moneyBrl(custoDelta.anterior) %></p>
    </div>
  <% } %>
</section>

<% if (alocacoes && alocacoes.length) { %>
<section class="panel mb-4">
  <div class="panel-head"><h2>Alocações neste pedido</h2></div>
  <div class="table-panel" style="border:0;border-radius:0">
    <table>
      <thead>
        <tr>
          <th>Pagamento</th>
          <th>USD</th>
          <th class="col-hide-sm">Dólar</th>
          <th>BRL</th>
        </tr>
      </thead>
      <tbody>
        <% alocacoes.forEach(function(a) { %>
          <tr>
            <td>#<%= a.pagamento_id %> · <%= a.pagamento_descricao %></td>
            <td class="num"><%= moneyUsd(a.valor_usd) %></td>
            <td class="num col-hide-sm"><%= numberBr(a.dolar_dia, 4) %></td>
            <td class="num"><%= moneyBrl(a.valor_brl) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<form method="POST" action="/desembaraco/<%= pedido.id %>">
  <section class="panel form-panel mb-4">
    <div class="panel-head">
      <h2>Parâmetros do desembaraço</h2>
      <span class="badge <%= saldo.coberto ? 'badge-ok' : 'badge-warn' %>">
        <%= saldo.coberto ? 'editável' : 'bloqueado' %>
      </span>
    </div>
    <div class="form-section">
      <div class="form-grid form-grid-2">
        <div>
          <label class="label" for="custo_desembaraco_total">Custo desembaraço total L (amarelo)</label>
          <input class="field field-num input-yellow" type="text" inputmode="decimal" id="custo_desembaraco_total" name="custo_desembaraco_total" value="<%= formatInputBr(desembaraco.custo_desembaraco_total, 2) %>" placeholder="ex: 1.000,00" <%= saldo.coberto ? '' : 'disabled' %>>
          <p class="field-hint">Rateado nas linhas pela % do invoice.</p>
        </div>
        <div>
          <label class="label" for="divisor_bc_icms">Divisor BC ICMS</label>
          <input class="field field-num" type="text" inputmode="decimal" id="divisor_bc_icms" name="divisor_bc_icms" value="<%= formatInputBr(desembaraco.divisor_bc_icms, 4) %>" placeholder="ex: 0,9400" <%= saldo.coberto ? '' : 'disabled' %>>
          <p class="field-hint">Padrão usual: 0,9400.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="sheet-legend">
    <span class="sheet-legend-item">
      <span class="sheet-legend-swatch" aria-hidden="true"></span>
      Campo editável (amarelo)
    </span>
    <span class="sheet-legend-item">Demais colunas são calculadas ao salvar</span>
  </div>

  <% if (!linhas.length) { %>
    <p class="empty-state">Este pedido ainda não tem itens.</p>
  <% } else { %>
    <div class="desembaraco-sheet sheet-wrap sheet mb-3">
      <table>
        <thead>
          <tr>
            <th class="col-sticky">REF</th>
            <th>Qtd</th>
            <th>Unit USD</th>
            <th>Amount USD</th>
            <th>%</th>
            <th>Custo R$</th>
            <th>Custo unit R$</th>
            <th>NCM</th>
            <th class="col-edit">Base desemb. J</th>
            <th>II %</th>
            <th>II valor</th>
            <th>IPI %</th>
            <th>IPI valor</th>
            <th>PIS %</th>
            <th>PIS R$</th>
            <th>COFINS %</th>
            <th>COFINS</th>
            <th>BC ICMS</th>
            <th>ICMS %</th>
            <th>ICMS valor</th>
            <th>Custo imposto</th>
            <th>% imposto</th>
            <th>Outras desp.</th>
            <th>% s/ Custo unit R$</th>
            <th>Outras unit</th>
            <th>Total custo unit</th>
          </tr>
        </thead>
        <tbody>
          <% linhas.forEach(function(linha) { %>
            <tr>
              <td class="col-sticky" title="<%= linha.descricao || '' %>"><%= linha.referencia %></td>
              <td class="num"><%= numberBr(linha.quantidade, 0) %></td>
              <td class="num"><%= numberBr(linha.preco_usd, 2) %></td>
              <td class="num"><%= numberBr(linha.amount_usd, 2) %></td>
              <td class="num"><%= percentBr(linha.pct_rateio) %></td>
              <td class="num"><%= saldo.coberto ? numberBr(linha.custo_rs, 2) : '—' %></td>
              <td class="num"><%= saldo.coberto ? numberBr(linha.custo_unit_rs, 2) : '—' %></td>
              <td class="mono"><%= linha.ncm || '—' %></td>
              <td class="col-edit-cell">
                <input
                  class="input-yellow field-num"
                  type="text"
                  inputmode="decimal"
                  name="base_<%= linha.id %>"
                  value="<%= formatInputBr(linha.base_desembaraco, 2) %>"
                  placeholder="0,00"
                  aria-label="Base desembaraço <%= linha.referencia %>"
                >
              </td>
              <td class="num"><%= percentBr(linha.aliq_ii) %></td>
              <td class="num"><%= numberBr(linha.ii_valor, 2) %></td>
              <td class="num"><%= percentBr(linha.aliq_ipi) %></td>
              <td class="num"><%= numberBr(linha.ipi_valor, 2) %></td>
              <td class="num"><%= percentBr(linha.aliq_pis) %></td>
              <td class="num"><%= numberBr(linha.pis_rs, 2) %></td>
              <td class="num"><%= percentBr(linha.aliq_cofins) %></td>
              <td class="num"><%= numberBr(linha.cofins_valor, 2) %></td>
              <td class="num"><%= numberBr(linha.bc_icms, 2) %></td>
              <td class="num"><%= percentBr(linha.aliq_icms) %></td>
              <td class="num"><%= numberBr(linha.valor_icms, 2) %></td>
              <td class="num"><%= numberBr(linha.custo_imposto, 2) %></td>
              <td class="num"><%= saldo.coberto && linha.pct_imposto != null ? percentBr(linha.pct_imposto) : '—' %></td>
              <td class="num"><%= numberBr(linha.outras_despesas, 2) %></td>
              <td class="num"><%= saldo.coberto && linha.pct_outras_despesas != null ? percentBr(linha.pct_outras_despesas) : '—' %></td>
              <td class="num"><%= numberBr(linha.outras_despesas_unit, 2) %></td>
              <td class="num font-semibold"><%= saldo.coberto ? numberBr(linha.total_custo_unit, 2) : '—' %></td>
            </tr>
          <% }) %>
          <tr class="sheet-total">
            <td class="col-sticky">TOTAL</td>
            <td class="num"><%= numberBr(totais.quantidade, 0) %></td>
            <td></td>
            <td class="num"><%= numberBr(totais.amount_usd, 2) %></td>
            <td class="num">100%</td>
            <td class="num"><%= saldo.coberto ? numberBr(totais.custo_rs, 2) : '—' %></td>
            <td colspan="14"></td>
            <td class="num"><%= numberBr(totais.custo_imposto, 2) %></td>
            <td></td>
            <td class="num"><%= numberBr(totais.outras_despesas, 2) %></td>
            <td colspan="3"></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="sheet-actions">
    <div class="sheet-actions-totals">
      <span>Invoice <strong><%= moneyUsd(totais.amount_usd) %></strong></span>
      <span>Custo produto <strong><%= saldo.coberto ? moneyBrl(totais.custo_rs) : '—' %></strong></span>
      <span>Impostos <strong><%= moneyBrl(totais.custo_imposto) %></strong></span>
    </div>
    <button type="submit" class="btn btn-primary" <%= saldo.coberto ? '' : 'disabled' %>>Salvar e recalcular</button>
  </div>
</form>

<%- include('../partials/footer') %>
