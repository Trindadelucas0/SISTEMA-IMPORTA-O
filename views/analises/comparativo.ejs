<%- include('../partials/header') %>

<%
  const modoAtual = typeof modo !== 'undefined' ? modo : 'automatico';
  const info = typeof modoInfo !== 'undefined' ? modoInfo : null;

  const labelPrecoA = modoAtual === 'dois_pedidos' ? 'Preço A' : (modoAtual === 'pedido_base' ? 'Preço' : 'Preço atual');
  const labelPrecoB = modoAtual === 'dois_pedidos' ? 'Preço B' : 'Preço ant.';

  let bannerHtml = null;
  if (modoAtual === 'dois_pedidos' && info?.pedidoA && info?.pedidoB) {
    bannerHtml = {
      tipo: 'dois',
      aCodigo: info.pedidoA.codigo,
      aData: info.pedidoA.data,
      aForn: info.pedidoA.fornecedor || '',
      bCodigo: info.pedidoB.codigo,
      bData: info.pedidoB.data,
      bForn: info.pedidoB.fornecedor || '',
    };
  } else if (modoAtual === 'pedido_base' && info?.pedidoBase) {
    bannerHtml = {
      tipo: 'base',
      aCodigo: info.pedidoBase.codigo,
      aData: info.pedidoBase.data,
      aForn: info.pedidoBase.fornecedor || '',
    };
  } else if (modoAtual === 'automatico' && itens.length) {
    bannerHtml = { tipo: 'auto' };
  }

  const estaveis = itens.filter(function (i) {
    return i.anterior && !i.aumentouPreco && !i.diminuiuPreco;
  }).length;
  const semHistorico = itens.filter(function (i) { return !i.anterior; }).length;

  const topVariacoes = itens
    .filter(function (i) { return i.deltaPrecoPct != null && i.deltaPrecoPct !== 0; })
    .slice(0, 8);

  const chartTopLabels = topVariacoes.map(function (i) {
    const ref = String(i.referencia || '');
    return ref.length > 14 ? ref.slice(0, 12) + '…' : ref;
  });
  const chartTopValues = topVariacoes.map(function (i) { return i.deltaPrecoPct; });
  const chartTopColors = topVariacoes.map(function (i) {
    return i.aumentouPreco ? '#B42318' : '#067647';
  });
%>

<section class="page-header mb-3 flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="page-eyebrow">Análises</p>
    <h1 class="page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : title %></h1>
    <p class="page-sub"><%= typeof pageSub !== 'undefined' ? pageSub : 'Última vs anterior por referência.' %></p>
  </div>
  <a href="/analises" class="btn btn-ghost btn-sm">Voltar ao hub</a>
</section>

<section class="kpi-grid kpi-grid-5 mb-3">
  <div class="stat">
    <p class="stat-label">Itens</p>
    <p class="stat-value"><%= kpis.totalItens %></p>
    <p class="stat-meta"><%= kpis.comHistorico %> com histórico</p>
  </div>
  <div class="stat">
    <p class="stat-label">Alta de preço</p>
    <p class="stat-value text-bad"><%= kpis.aumentos %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Queda de preço</p>
    <p class="stat-value text-ok"><%= kpis.quedas %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Trocas fornecedor</p>
    <p class="stat-value"><%= kpis.trocas %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Média Δ preço</p>
    <p class="stat-value"><%= kpis.mediaVariacaoPct != null ? (kpis.mediaVariacaoPct > 0 ? '+' : '') + numberBr(kpis.mediaVariacaoPct, 1) + '%' : '—' %></p>
  </div>
</section>

<section class="panel mb-3">
  <form method="GET" action="/analises/comparativo" class="panel-body" id="form-comparativo">
    <p class="label" style="margin-bottom:0.4rem">Modo de comparação</p>
    <div class="cmp-mode-tabs" role="radiogroup" aria-label="Modo de comparação">
      <label class="cmp-mode-tab <%= modoAtual === 'automatico' ? 'is-active' : '' %>">
        <input type="radio" name="modo" value="automatico" <%= modoAtual === 'automatico' ? 'checked' : '' %> data-modo-toggle>
        <span class="cmp-mode-tab-title">Automático</span>
        <span class="cmp-mode-tab-desc">Última compra vs anterior da mesma referência</span>
      </label>
      <label class="cmp-mode-tab <%= modoAtual === 'dois_pedidos' ? 'is-active' : '' %>">
        <input type="radio" name="modo" value="dois_pedidos" <%= modoAtual === 'dois_pedidos' ? 'checked' : '' %> data-modo-toggle>
        <span class="cmp-mode-tab-title">Dois pedidos</span>
        <span class="cmp-mode-tab-desc">Itens em comum entre Pedido A e Pedido B</span>
      </label>
      <label class="cmp-mode-tab <%= modoAtual === 'pedido_base' ? 'is-active' : '' %>">
        <input type="radio" name="modo" value="pedido_base" <%= modoAtual === 'pedido_base' ? 'checked' : '' %> data-modo-toggle>
        <span class="cmp-mode-tab-title">Pedido base</span>
        <span class="cmp-mode-tab-desc">Itens do pedido vs compra anterior</span>
      </label>
    </div>

    <div class="filters-inline" data-modo-panel="dois_pedidos" style="<%= modoAtual === 'dois_pedidos' ? '' : 'display:none' %>;margin:0.85rem 0 0.75rem">
      <div>
        <label class="label" for="pedido_a">Pedido A (atual)</label>
        <select class="field" id="pedido_a" name="pedido_a">
          <option value="">Selecione</option>
          <% pedidos.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= String(filtros.pedido_a) === String(p.id) ? 'selected' : '' %>>
              <%= p.codigo %> · <%= formatDateBr(p.created_at) %><%= p.fornecedor_nome ? ' · ' + p.fornecedor_nome : '' %>
            </option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="label" for="pedido_b">Pedido B (comparar)</label>
        <select class="field" id="pedido_b" name="pedido_b">
          <option value="">Selecione</option>
          <% pedidos.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= String(filtros.pedido_b) === String(p.id) ? 'selected' : '' %>>
              <%= p.codigo %> · <%= formatDateBr(p.created_at) %><%= p.fornecedor_nome ? ' · ' + p.fornecedor_nome : '' %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div data-modo-panel="pedido_base" style="<%= modoAtual === 'pedido_base' ? '' : 'display:none' %>;margin:0.85rem 0 0.75rem">
      <label class="label" for="pedido_id">Pedido base</label>
      <select class="field" id="pedido_id" name="pedido_id">
        <option value="">Selecione</option>
        <% pedidos.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= String(filtros.pedido_id) === String(p.id) ? 'selected' : '' %>>
            <%= p.codigo %> · <%= formatDateBr(p.created_at) %><%= p.fornecedor_nome ? ' · ' + p.fornecedor_nome : '' %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="filters-inline" style="margin-top:0.75rem">
      <div>
        <label class="label" for="q">Busca</label>
        <input class="field" id="q" name="q" value="<%= filtros.q || '' %>" placeholder="Referência ou descrição">
      </div>
      <div>
        <label class="label" for="fornecedor_id">Fornecedor</label>
        <select class="field" id="fornecedor_id" name="fornecedor_id">
          <option value="">Todos</option>
          <% fornecedores.forEach(function(f) { %>
            <option value="<%= f.id %>" <%= String(filtros.fornecedor_id) === String(f.id) ? 'selected' : '' %>><%= f.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="filters-inline-actions">
        <button type="submit" class="btn btn-primary btn-sm">Comparar</button>
        <a href="/analises/comparativo" class="btn btn-ghost btn-sm">Limpar</a>
      </div>
    </div>
    <div class="filters-inline-checks" style="margin-top:0.65rem">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="somenteVariacao" value="1" <%= filtros.somenteVariacao ? 'checked' : '' %>>
        Só com variação de preço
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="somenteTroca" value="1" <%= filtros.somenteTroca ? 'checked' : '' %>>
        Só troca de fornecedor
      </label>
    </div>
  </form>
</section>

<% if (typeof aviso !== 'undefined' && aviso === 'pedido_sem_historico_anterior' && itens.length) { %>
  <p class="alert alert-warn" role="status">Os itens deste pedido ainda não têm compra anterior para comparar variação.</p>
<% } %>

<% if (bannerHtml && itens.length) { %>
  <div class="cmp-banner mb-3" role="status">
    <% if (bannerHtml.tipo === 'dois') { %>
      <div class="cmp-banner-side">
        <span class="cmp-banner-label">Pedido A</span>
        <span class="cmp-banner-code mono"><%= bannerHtml.aCodigo %></span>
        <span class="cmp-banner-meta"><%= formatDateBr(bannerHtml.aData) %><% if (bannerHtml.aForn) { %> · <span class="cell-clip" title="<%= bannerHtml.aForn %>"><%= bannerHtml.aForn %></span><% } %></span>
      </div>
      <div class="cmp-banner-vs" aria-hidden="true">→</div>
      <div class="cmp-banner-side">
        <span class="cmp-banner-label">Pedido B</span>
        <span class="cmp-banner-code mono"><%= bannerHtml.bCodigo %></span>
        <span class="cmp-banner-meta"><%= formatDateBr(bannerHtml.bData) %><% if (bannerHtml.bForn) { %> · <span class="cell-clip" title="<%= bannerHtml.bForn %>"><%= bannerHtml.bForn %></span><% } %></span>
      </div>
    <% } else if (bannerHtml.tipo === 'base') { %>
      <div class="cmp-banner-side">
        <span class="cmp-banner-label">Pedido base</span>
        <span class="cmp-banner-code mono"><%= bannerHtml.aCodigo %></span>
        <span class="cmp-banner-meta"><%= formatDateBr(bannerHtml.aData) %><% if (bannerHtml.aForn) { %> · <span class="cell-clip" title="<%= bannerHtml.aForn %>"><%= bannerHtml.aForn %></span><% } %></span>
      </div>
      <div class="cmp-banner-vs" aria-hidden="true">vs</div>
      <div class="cmp-banner-side">
        <span class="cmp-banner-label">Comparado com</span>
        <span class="cmp-banner-code">compra anterior</span>
        <span class="cmp-banner-meta">da mesma referência em cada item</span>
      </div>
    <% } else { %>
      <div class="cmp-banner-side">
        <span class="cmp-banner-label">Modo</span>
        <span class="cmp-banner-code">Automático</span>
        <span class="cmp-banner-meta">Última compra vs anterior por referência · itens com maior Δ no topo</span>
      </div>
    <% } %>
  </div>
<% } %>

<% if (!itens.length) { %>
  <p class="empty-state"><%= typeof emptyMessage !== 'undefined' ? emptyMessage : 'Nenhum item encontrado com esses filtros.' %></p>
<% } else { %>
  <section class="cmp-charts panel mb-3">
    <div class="panel-head"><h2>Visão da variação</h2></div>
    <div class="cmp-charts-grid panel-body">
      <div class="cmp-chart-card">
        <p class="cmp-chart-title">Situação do preço</p>
        <div class="cmp-chart-wrap">
          <canvas id="chartCmpSituacao" aria-label="Gráfico de situação do preço"></canvas>
        </div>
      </div>
      <div class="cmp-chart-card">
        <p class="cmp-chart-title">Maiores variações</p>
        <% if (!topVariacoes.length) { %>
          <p class="stat-meta" style="padding:1rem 0">Nenhuma variação de preço neste resultado.</p>
        <% } else { %>
          <div class="cmp-chart-wrap cmp-chart-wrap-bar">
            <canvas id="chartCmpTop" aria-label="Gráfico das maiores variações de preço"></canvas>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <div class="panel">
    <div class="panel-head flex flex-wrap items-center justify-between gap-2">
      <h2>
        <%= itens.length %> item<%= itens.length === 1 ? '' : 's' %>
        <span class="stat-meta" style="font-weight:400;margin-left:0.35rem">ordenados por |Δ preço|</span>
      </h2>
      <p class="cmp-scroll-hint">Deslize para ver mais colunas</p>
    </div>
    <div class="table-panel cmp-table" style="border:0;border-radius:0">
      <table>
        <thead>
          <tr>
            <th class="col-sticky">Item</th>
            <th class="num"><%= labelPrecoA %></th>
            <th class="num"><%= labelPrecoB %></th>
            <th class="num">Δ preço</th>
            <th class="col-hide-sm">Qtd <%= modoAtual === 'dois_pedidos' ? 'A → B' : 'atual → ant.' %></th>
            <th class="col-hide-sm">Forn.</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% itens.forEach(function(it) {
            const rowClass = it.aumentouPreco ? 'cmp-row-up' : (it.diminuiuPreco ? 'cmp-row-down' : '');
            const qtdA = it.ultima ? numberBr(it.ultima.quantidade, 0) : '—';
            const qtdB = it.anterior ? numberBr(it.anterior.quantidade, 0) : '—';
          %>
            <tr class="<%= rowClass %>">
              <td class="col-sticky">
                <div class="cell-stack">
                  <% if (it.descricao) { %>
                    <span class="font-medium cell-clip cell-clip-md" title="<%= it.descricao %>"><%= it.descricao %></span>
                  <% } %>
                  <a class="link-action mono" href="/analises/comparativo/item/<%= encodeURIComponent(it.referencia) %>"><%= it.referencia %></a>
                  <% if (it.ultima) { %>
                    <span class="stat-meta">
                      <a class="link-action" href="/pedidos/<%= it.ultima.pedido_id %>"><%= it.ultima.pedido_codigo %></a>
                      · <%= formatDateBr(it.ultima.data) %>
                      <% if (it.anterior) { %>
                        <span aria-hidden="true"> · vs <%= it.anterior.pedido_codigo %></span>
                      <% } %>
                    </span>
                  <% } %>
                </div>
              </td>
              <td class="num">
                <% if (it.ultima) { %>
                  <span class="mono font-medium"><%= moneyUsd(it.ultima.preco_usd) %></span>
                <% } else { %>—<% } %>
              </td>
              <td class="num">
                <% if (it.anterior) { %>
                  <span class="mono"><%= moneyUsd(it.anterior.preco_usd) %></span>
                <% } else { %>—<% } %>
              </td>
              <td class="num">
                <% if (it.deltaPrecoUsd == null) { %>
                  —
                <% } else { %>
                  <div class="cell-stack" style="align-items:flex-end">
                    <% if (it.aumentouPreco) { %>
                      <span class="mono text-bad font-medium">+<%= moneyUsd(Math.abs(it.deltaPrecoUsd)) %></span>
                      <span class="stat-meta text-bad">+<%= numberBr(it.deltaPrecoPct, 1) %>%</span>
                    <% } else if (it.diminuiuPreco) { %>
                      <span class="mono text-ok font-medium"><%= moneyUsd(it.deltaPrecoUsd) %></span>
                      <span class="stat-meta text-ok"><%= numberBr(it.deltaPrecoPct, 1) %>%</span>
                    <% } else { %>
                      <span class="mono">$0.00</span>
                      <span class="stat-meta">0%</span>
                    <% } %>
                  </div>
                <% } %>
              </td>
              <td class="col-hide-sm">
                <div class="cell-stack">
                  <span class="mono"><%= qtdA %> → <%= qtdB %></span>
                  <% if (it.deltaQtdPct != null) { %>
                    <% if (it.aumentouQtd) { %>
                      <span class="stat-meta text-bad">+<%= numberBr(it.deltaQtdPct, 1) %>%</span>
                    <% } else if (it.diminuiuQtd) { %>
                      <span class="stat-meta text-ok"><%= numberBr(it.deltaQtdPct, 1) %>%</span>
                    <% } else { %>
                      <span class="stat-meta">0%</span>
                    <% } %>
                  <% } %>
                </div>
              </td>
              <td class="col-hide-sm">
                <% if (it.ultima?.fornecedor) { %>
                  <div class="cell-stack">
                    <span class="cell-clip cell-clip-md" title="<%= it.ultima.fornecedor %>"><%= it.ultima.fornecedor %></span>
                    <% if (it.trocouFornecedor && it.anterior?.fornecedor) { %>
                      <span class="stat-meta cell-clip" title="<%= it.anterior.fornecedor %>">era: <%= it.anterior.fornecedor %></span>
                    <% } %>
                  </div>
                <% } else { %>—<% } %>
              </td>
              <td>
                <div class="badge-row">
                  <% if (it.aumentouPreco) { %><span class="badge badge-danger">alta</span><% } %>
                  <% if (it.diminuiuPreco) { %><span class="badge badge-ok">queda</span><% } %>
                  <% if (it.trocouFornecedor) { %><span class="badge badge-warn">troca</span><% } %>
                  <% if (!it.aumentouPreco && !it.diminuiuPreco && !it.trocouFornecedor) { %><span class="stat-meta">estável</span><% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
  (function () {
    if (!window.Chart) return;
    var font = { family: 'IBM Plex Sans', size: 11 };
    var aumentos = <%= Number(kpis.aumentos) || 0 %>;
    var quedas = <%= Number(kpis.quedas) || 0 %>;
    var estaveis = <%= Number(estaveis) || 0 %>;
    var semHistorico = <%= Number(semHistorico) || 0 %>;

    var ctxSit = document.getElementById('chartCmpSituacao');
    if (ctxSit) {
      var sitLabels = ['Alta', 'Queda', 'Estável'];
      var sitData = [aumentos, quedas, estaveis];
      var sitColors = ['#B42318', '#067647', '#94A3B8'];
      if (semHistorico > 0) {
        sitLabels.push('Sem hist.');
        sitData.push(semHistorico);
        sitColors.push('#CBD5E1');
      }
      new Chart(ctxSit, {
        type: 'doughnut',
        data: {
          labels: sitLabels,
          datasets: [{
            data: sitData,
            backgroundColor: sitColors,
            borderWidth: 0,
            hoverOffset: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: { boxWidth: 10, font: font }
            }
          }
        }
      });
    }

    var topLabels = <%- JSON.stringify(chartTopLabels) %>;
    var topValues = <%- JSON.stringify(chartTopValues) %>;
    var topColors = <%- JSON.stringify(chartTopColors) %>;
    var ctxTop = document.getElementById('chartCmpTop');
    if (ctxTop && topLabels.length) {
      new Chart(ctxTop, {
        type: 'bar',
        data: {
          labels: topLabels,
          datasets: [{
            label: 'Δ preço %',
            data: topValues,
            backgroundColor: topColors,
            borderRadius: 2,
            maxBarThickness: 22
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) {
                  var v = ctx.parsed.x;
                  return ' ' + (v > 0 ? '+' : '') + v.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#ECEEF2' },
              ticks: {
                font: font,
                callback: function (v) { return (v > 0 ? '+' : '') + v + '%'; }
              }
            },
            y: {
              grid: { display: false },
              ticks: { font: font }
            }
          }
        }
      });
    }
  })();
  </script>
<% } %>

<script>
(function () {
  var form = document.getElementById('form-comparativo');
  if (!form) return;
  var radios = form.querySelectorAll('[data-modo-toggle]');
  var panels = form.querySelectorAll('[data-modo-panel]');
  var tabs = form.querySelectorAll('.cmp-mode-tab');
  function sync() {
    var modo = 'automatico';
    radios.forEach(function (r) { if (r.checked) modo = r.value; });
    panels.forEach(function (p) {
      p.style.display = p.getAttribute('data-modo-panel') === modo ? '' : 'none';
    });
    tabs.forEach(function (tab) {
      var input = tab.querySelector('input');
      tab.classList.toggle('is-active', input && input.checked);
    });
  }
  radios.forEach(function (r) { r.addEventListener('change', sync); });
  sync();
})();
</script>

<%- include('../partials/footer') %>
