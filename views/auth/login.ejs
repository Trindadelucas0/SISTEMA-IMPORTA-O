<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login · Importação</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@450;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F1F3F5;
      --surface: #FFFFFF;
      --ink: #111827;
      --muted: #6B7280;
      --border: #D8DCE3;
      --primary: #1B4F9C;
      --primary-hover: #163F7C;
      --danger: #B42318;
      --warning: #B54708;
      --radius: 4px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "IBM Plex Sans", system-ui, sans-serif;
      color: var(--ink);
      background:
        radial-gradient(ellipse 80% 50% at 20% 0%, rgba(27, 79, 156, 0.12), transparent),
        radial-gradient(ellipse 60% 40% at 100% 100%, rgba(15, 23, 42, 0.08), transparent),
        var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
    }
    .login-card {
      width: 100%;
      max-width: 22rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem 1.35rem;
    }
    .login-brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.25rem;
      font-weight: 600;
      font-size: 1rem;
      letter-spacing: -0.015em;
    }
    .login-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 3px;
      background: #1B4F9C;
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .login-brand span { color: var(--muted); font-weight: 400; margin-left: 0.15rem; }
    .login-title {
      margin: 0 0 0.25rem;
      font-size: 1.15rem;
      font-weight: 600;
    }
    .login-sub {
      margin: 0 0 1.15rem;
      font-size: 0.8125rem;
      color: var(--muted);
    }
    .label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      margin-bottom: 0.25rem;
      color: var(--muted);
    }
    .field {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.5rem 0.65rem;
      background: #fff;
      font-size: 16px;
      font-family: inherit;
      margin-bottom: 0.85rem;
    }
    .field:focus {
      outline: 1px solid #93B4DE;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(27, 79, 156, 0.12);
    }
    .btn {
      display: inline-flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: var(--radius);
      padding: 0.5rem 0.85rem;
      font-size: 0.875rem;
      font-weight: 500;
      border: 1px solid var(--primary);
      cursor: pointer;
      background: var(--primary);
      color: #fff;
      font-family: inherit;
    }
    .btn:hover { background: var(--primary-hover); }
    .alert {
      border-radius: var(--radius);
      border: 1px solid;
      padding: 0.55rem 0.75rem;
      font-size: 0.8125rem;
      margin-bottom: 1rem;
    }
    .alert-error { background: #FEF3F2; border-color: #FECDCA; color: var(--danger); }
    .alert-warn { background: #FFFAEB; border-color: #FEDF89; color: var(--warning); }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-brand">
      <span class="login-mark" aria-hidden="true">IM</span>
      Importação
    </div>
    <h1 class="login-title">Entrar</h1>
    <p class="login-sub">Acesse com seu usuário e senha.</p>

    <% if (warning) { %>
      <div class="alert alert-warn" role="alert"><%= warning %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" autocomplete="on">
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
      <label class="label" for="username">Usuário</label>
      <input class="field" id="username" name="username" type="text" required
             value="<%= typeof username !== 'undefined' ? username : '' %>"
             autocomplete="username" autofocus>
      <label class="label" for="password">Senha</label>
      <input class="field" id="password" name="password" type="password" required
             autocomplete="current-password">
      <button type="submit" class="btn">Entrar</button>
    </form>
  </div>
</body>
</html>
