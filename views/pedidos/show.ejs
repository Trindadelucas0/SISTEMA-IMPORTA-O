<%- include('../partials/header') %>

<%
  const invoice = Number(saldo.invoice_usd) || 0;
  const alocado = Number(saldo.alocado_usd) || 0;
  const falta = Number(saldo.falta_usd) || 0;
  const coberturaPct = invoice > 0
    ? Math.min(100, Math.round((alocado / invoice) * 1000) / 10)
    : (saldo.coberto ? 100 : 0);
  const badgeClass = saldo.coberto ? 'badge-ok' : (alocado > 0 ? 'badge-warn' : 'badge-danger');
%>

<section class="page-header mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="page-eyebrow">Pedido</p>
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="page-title mono"><%= pedido.codigo %></h1>
      <%- include('../partials/status-pedido', { pedidoId: pedido.id, status: pedido.status }) %>
      <span id="badge-cobertura-status" class="badge <%= badgeClass %>" title="Situação do pagamento ao fornecedor">
        <%= saldo.coberto ? 'Quitado fornecedor' : 'Aguardando saldo' %>
      </span>
    </div>
    <p class="page-sub"><%= pedido.fornecedor || 'Sem fornecedor' %></p>
    <p class="page-sub mt-1">
      Fabricação: <%= formatDateBr(pedido.data_inicio_fabricacao) %>
      · Prevista chegada: <%= formatDateBr(pedido.data_prevista_chegada) %>
    </p>
  </div>
  <div class="toolbar">
    <a href="/pedidos/<%= pedido.id %>/editar" class="btn btn-ghost btn-sm">Editar</a>
    <a href="/saldo" class="btn btn-ghost btn-sm">Saldo</a>
    <a href="/pagamentos/novo" class="btn btn-ghost btn-sm">Pagamento</a>
    <a href="/desembaraco/<%= pedido.id %>/relatorio" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">Relatório custo</a>
    <a href="/desembaraco/<%= pedido.id %>" class="btn btn-primary btn-sm">Compras</a>
    <form method="POST" action="/pedidos/<%= pedido.id %>?_method=DELETE" onsubmit="return confirm('Excluir pedido e itens?')">
      <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
    </form>
  </div>
</section>

<% if (typeof statusOk !== 'undefined' && statusOk) { %>
  <p class="alert alert-success" role="status">Status atualizado.</p>
<% } %>
<% if (typeof statusErro !== 'undefined' && statusErro) { %>
  <p class="alert alert-error" role="alert">Status inválido. Escolha Aberta, Em Trânsito ou Embarcada.</p>
<% } %>

<section class="coverage-block mb-4" id="cobertura-block">
  <div class="mb-2 flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="stat-label">Cobertura do invoice</p>
      <p class="mono mt-1 text-lg font-semibold" id="cobertura-pct"><%= coberturaPct %>%</p>
    </div>
    <p class="stat-meta mono" id="cobertura-meta">
      Alocado <%= moneyUsd(alocado) %> · Falta <%= moneyUsd(falta) %> · Invoice <%= moneyUsd(invoice) %>
    </p>
  </div>
  <div id="cobertura-progress" class="progress <%= saldo.coberto ? 'progress-ok' : (coberturaPct > 0 ? 'progress-warn' : '') %>">
    <span id="cobertura-bar" style="width: <%= coberturaPct %>%"></span>
  </div>
</section>

<section class="kpi-grid mb-4">
  <div class="stat">
    <p class="stat-label">Invoice USD</p>
    <p class="stat-value" id="kpi-invoice"><%= moneyUsd(invoice) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Alocado</p>
    <p class="stat-value" id="kpi-alocado"><%= moneyUsd(alocado) %></p>
    <p class="stat-meta" id="kpi-alocado-brl"><%= moneyBrl(saldo.alocado_brl) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Falta USD</p>
    <p class="stat-value <%= falta > 0 ? 'text-bad' : 'text-ok' %>" id="kpi-falta"><%= moneyUsd(falta) %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Prevista de chegada</p>
    <p class="stat-value" style="font-size:1.15rem"><%= formatDateBr(pedido.data_prevista_chegada) %></p>
    <p class="stat-meta">Início fab. <%= formatDateBr(pedido.data_inicio_fabricacao) %></p>
  </div>
  <% if (desembaraco && desembaraco.custo_total_atual != null) { %>
    <div class="stat">
      <p class="stat-label">Custo landado</p>
      <p class="stat-value"><%= moneyBrl(desembaraco.custo_total_atual) %></p>
    </div>
  <% } %>
  <% if (custoDelta) { %>
    <div class="stat">
      <p class="stat-label">Variação do custo</p>
      <% if (custoDelta.aumentou) { %>
        <p class="stat-value text-bad">+ <%= moneyBrl(custoDelta.delta) %></p>
      <% } else if (custoDelta.diminuiu) { %>
        <p class="stat-value text-ok">− <%= moneyBrl(Math.abs(custoDelta.delta)) %></p>
      <% } else { %>
        <p class="stat-value">Sem variação</p>
      <% } %>
    </div>
  <% } %>
</section>

<p class="alert alert-warn" id="alerta-saldo" <%= saldo.coberto ? 'hidden' : '' %>>
  Pedido ainda não quitado no saldo. Aloque pagamentos em <a class="link-action" href="/saldo">Saldo</a> antes do desembaraço / custo unitário.
</p>

<% if (alocacoes && alocacoes.length) { %>
<section class="panel mb-4">
  <div class="panel-head"><h2>Alocações neste pedido</h2></div>
  <div class="table-panel" style="border:0;border-radius:0">
    <table>
      <thead>
        <tr>
          <th>Pagamento</th>
          <th>USD</th>
          <th>Dólar</th>
          <th>BRL</th>
        </tr>
      </thead>
      <tbody>
        <% alocacoes.forEach(function(a) { %>
          <tr>
            <td>#<%= a.pagamento_id %> · <%= a.pagamento_descricao %></td>
            <td class="num"><%= moneyUsd(a.valor_usd) %></td>
            <td class="num"><%= numberBr(a.dolar_dia, 4) %></td>
            <td class="num"><%= moneyBrl(a.valor_brl) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section class="pedido-layout mb-4">
  <div class="panel" id="painel-itens" data-pedido-id="<%= pedido.id %>">
    <div class="panel-head">
      <h2>Itens do invoice</h2>
      <span class="badge" id="itens-badge"><%= itens.length %> item(ns)</span>
    </div>
    <div class="panel-body" id="itens-empty" <%= itens.length ? 'hidden' : '' %>>
      <p class="empty-state">Nenhum item neste pedido.</p>
    </div>
    <div id="itens-table-wrap" <%= itens.length ? '' : 'hidden' %>>
      <p class="table-scroll-hint px-3 pt-2">Deslize a tabela para o lado para ver mais colunas.</p>
      <div class="table-panel" style="border:0;border-radius:0">
        <table>
          <thead>
            <tr>
              <th>REF</th>
              <th class="col-hide-sm">Descrição</th>
              <th>Qtd</th>
              <th>Unit USD</th>
              <th>Amount</th>
              <th class="col-hide-sm">NCM</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="itens-tbody">
            <% itens.forEach(function(item) { %>
              <tr class="align-top" data-item-id="<%= item.id %>">
                <td class="font-medium mono">
                  <a class="link-action" href="/analises/comparativo/item/<%= encodeURIComponent(item.referencia) %>" title="Ver análise vs última compra"><%= item.referencia %></a>
                </td>
                <td class="max-w-xs whitespace-normal text-xs col-hide-sm" style="color:var(--muted)"><%= item.descricao || '—' %></td>
                <td class="num"><%= numberBr(item.quantidade, 0) %></td>
                <td class="num"><%= numberBr(item.preco_usd, 2) %></td>
                <td class="num font-semibold"><%= moneyUsd(item.amount_usd) %></td>
                <td class="mono col-hide-sm"><%= item.ncm || '—' %></td>
                <td class="text-right space-x-2">
                  <a class="link-action" href="/analises/comparativo/item/<%= encodeURIComponent(item.referencia) %>">vs última</a>
                  <form class="inline form-remover-item" method="POST" action="/pedidos/<%= pedido.id %>/itens/<%= item.id %>?_method=DELETE">
                    <button type="submit" class="link-danger">Remover</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="panel form-panel">
    <div class="panel-head">
      <h2>Adicionar item</h2>
    </div>
    <p id="form-item-status" class="alert" hidden role="status" style="margin:0.75rem 1rem 0"></p>
    <form method="POST" action="/pedidos/<%= pedido.id %>/itens" id="form-adicionar-item">
      <div class="form-section">
        <h3 class="form-section-title">Produto</h3>
        <div class="form-grid">
          <%- include('../partials/produto-combobox', { produtos: typeof locals.produtos !== 'undefined' ? locals.produtos : [] }) %>
          <div>
            <label class="label" for="referencia">REF</label>
            <input class="field mono" id="referencia" name="referencia" required placeholder="AC200 ALUMINIO" autocomplete="off">
          </div>
          <div>
            <label class="label" for="descricao">Descrição</label>
            <input class="field" id="descricao" name="descricao" placeholder="Descrição comercial do item">
          </div>
          <div>
            <label class="label" for="ncm">NCM</label>
            <input class="field mono" id="ncm" name="ncm" placeholder="84289090" inputmode="numeric">
            <p class="field-hint">8 dígitos, sem pontuação.</p>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3 class="form-section-title">Quantidade e preço</h3>
        <div class="form-grid form-grid-2">
          <div>
            <label class="label" for="quantidade">Quantidade</label>
            <input class="field field-num" id="quantidade" name="quantidade" type="text" inputmode="decimal" value="0" placeholder="ex: 1.000" required>
          </div>
          <div>
            <label class="label" for="preco_usd">Unit USD</label>
            <input class="field field-num" id="preco_usd" name="preco_usd" type="text" inputmode="decimal" value="0,00" placeholder="ex: 12,50" required>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h3 class="form-section-title">Alíquotas (decimal)</h3>
        <div class="form-grid form-grid-2">
          <div>
            <label class="label" for="aliq_ii">II</label>
            <input class="field field-num" id="aliq_ii" name="aliq_ii" type="text" inputmode="decimal" value="0,20" placeholder="0,20">
          </div>
          <div>
            <label class="label" for="aliq_ipi">IPI</label>
            <input class="field field-num" id="aliq_ipi" name="aliq_ipi" type="text" inputmode="decimal" value="0" placeholder="0,00">
          </div>
          <div>
            <label class="label" for="aliq_pis">PIS</label>
            <input class="field field-num" id="aliq_pis" name="aliq_pis" type="text" inputmode="decimal" value="0,021" placeholder="0,021">
          </div>
          <div>
            <label class="label" for="aliq_cofins">COFINS</label>
            <input class="field field-num" id="aliq_cofins" name="aliq_cofins" type="text" inputmode="decimal" value="0,1025" placeholder="0,1025">
          </div>
          <div>
            <label class="label" for="aliq_icms">ICMS</label>
            <input class="field field-num" id="aliq_icms" name="aliq_icms" type="text" inputmode="decimal" value="0,04" placeholder="0,04">
          </div>
        </div>
        <p class="field-hint" style="margin-top:0.65rem">Use vírgula decimal. Ex.: 20% = 0,20.</p>
      </div>

      <div class="form-actions form-actions-start">
        <button type="submit" class="btn btn-primary" id="btn-adicionar-item">Adicionar item</button>
      </div>
    </form>
  </div>
</section>

<script src="/js/produto-combobox.js"></script>
<script src="/js/pedido-itens.js"></script>

<%- include('../partials/footer') %>
