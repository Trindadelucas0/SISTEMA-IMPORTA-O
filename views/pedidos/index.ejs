<%- include('../partials/header') %>

<%
  const chartLabels = (pedidosAbertos || []).map(function(p) { return p.codigo; });
  const chartAlocado = (pedidosAbertos || []).map(function(p) { return Number(p.alocado_usd) || 0; });
  const chartFalta = (pedidosAbertos || []).map(function(p) { return Number(p.falta_usd) || 0; });
%>

<section class="page-header mb-4 flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="page-eyebrow">Cadastro</p>
    <h1 class="page-title">Pedidos</h1>
    <p class="page-sub">Importações e preenchimento de pagamento nos abertos.</p>
  </div>
  <a href="/pedidos/novo" class="btn btn-primary">Novo pedido</a>
</section>

<% if (!pedidos.length) { %>
  <p class="empty-state">Nenhum pedido. Crie o primeiro.</p>
<% } else { %>

  <section class="panel mb-4">
    <div class="panel-head">
      <h2>Preenchimento dos pedidos abertos</h2>
      <span class="badge badge-info"><%= (pedidosAbertos || []).length %> aberto(s)</span>
    </div>
    <div class="panel-body">
      <% if (!(pedidosAbertos || []).length) { %>
        <p class="empty-state">Nenhum pedido aberto (todos fechados).</p>
      <% } else { %>
        <div class="chart-box">
          <canvas id="chartPedidosAbertos" aria-label="Preenchimento dos pedidos abertos"></canvas>
        </div>
      <% } %>
    </div>
  </section>

  <div class="panel">
    <p class="table-scroll-hint px-3 pt-2">Deslize a tabela para o lado para ver mais colunas.</p>
    <div class="table-panel" style="border:0;border-radius:0">
      <table>
        <thead>
          <tr>
            <th>Código</th>
            <th class="col-hide-sm">Fornecedor</th>
            <th>Status</th>
            <th class="col-hide-sm">Prevista chegada</th>
            <th class="col-hide-sm">Itens</th>
            <th>Total USD</th>
            <th>Preenchimento</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% pedidos.forEach(function(p) { %>
            <tr>
              <td class="font-semibold mono"><%= p.codigo %></td>
              <td class="col-hide-sm"><%= p.fornecedor || '—' %></td>
              <td><%- include('../partials/status-pedido', { pedidoId: p.id, status: p.status }) %></td>
              <td class="col-hide-sm mono"><%= formatDateBr(p.data_prevista_chegada) %></td>
              <td class="num col-hide-sm"><%= p.qtd_itens %></td>
              <td class="num"><%= moneyUsd(p.total_usd != null ? p.total_usd : p.invoice_usd) %></td>
              <td class="fill-cell">
                <div class="mb-1 flex flex-wrap items-center justify-between gap-1 text-xs" style="color:var(--muted)">
                  <span class="mono"><%= p.pct %>%</span>
                  <span class="badge <%= p.coberto ? 'badge-ok' : (p.pct > 0 ? 'badge-warn' : 'badge-danger') %>">
                    <%= p.coberto ? 'coberto' : 'falta ' + moneyUsd(p.falta_usd) %>
                  </span>
                </div>
                <div class="progress <%= p.coberto ? 'progress-ok' : (p.pct > 0 ? 'progress-warn' : '') %>">
                  <span style="width: <%= p.pct %>%"></span>
                </div>
              </td>
              <td class="text-right space-x-2">
                <a href="/pedidos/<%= p.id %>" class="link-action">Detalhe</a>
                <a href="/desembaraco/<%= p.id %>" class="link-action col-hide-sm">Compras</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<% if ((pedidosAbertos || []).length) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
  if (!window.Chart) return;
  const labels = <%- JSON.stringify(chartLabels) %>;
  const alocados = <%- JSON.stringify(chartAlocado) %>;
  const faltas = <%- JSON.stringify(chartFalta) %>;
  const el = document.getElementById('chartPedidosAbertos');
  if (!el || !labels.length) return;
  new Chart(el, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [
        { label: 'Alocado', data: alocados, backgroundColor: '#1B4F9C', borderRadius: 2, maxBarThickness: 28 },
        { label: 'Falta', data: faltas, backgroundColor: '#FDB022', borderRadius: 2, maxBarThickness: 28 }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 10, font: { family: 'IBM Plex Sans', size: 11 } } },
        tooltip: {
          callbacks: {
            label: function (ctx) {
              const v = ctx.parsed.y || 0;
              return ' ' + ctx.dataset.label + ': US$ ' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
          }
        }
      },
      scales: {
        x: { stacked: true, grid: { display: false }, ticks: { font: { family: 'IBM Plex Sans', size: 11 } } },
        y: { stacked: true, beginAtZero: true, grid: { color: '#ECEEF2' }, ticks: { font: { family: 'IBM Plex Sans', size: 11 } } }
      }
    }
  });
})();
</script>
<% } %>

<%- include('../partials/footer') %>
