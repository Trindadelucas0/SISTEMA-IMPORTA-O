<%- include('../partials/header') %>

<section class="page-header flex flex-wrap items-end justify-between gap-3">
  <div>
    <p class="page-eyebrow">Cadastro</p>
    <h1 class="page-title"><%= pedido && pedido.id ? 'Editar pedido' : 'Novo pedido' %></h1>
    <p class="page-sub">Dados da importação. Itens e impostos entram depois, no detalhe do pedido.</p>
  </div>
  <a href="/pedidos" class="btn btn-ghost btn-sm">Voltar à lista</a>
</section>

<% if (error) { %>
  <p class="alert alert-error" role="alert"><%= error %></p>
<% } %>

<form
  method="POST"
  action="<%= pedido && pedido.id ? '/pedidos/' + pedido.id + '?_method=PUT' : '/pedidos' %>"
  class="panel form-panel form-shell"
>
  <div class="form-section">
    <h2 class="form-section-title">Identificação</h2>
    <div class="form-grid form-grid-2">
      <div>
        <label class="label" for="codigo">Código</label>
        <input class="field mono" id="codigo" name="codigo" required value="<%= pedido?.codigo || '' %>" placeholder="A23" autocomplete="off">
        <p class="field-hint">Único no sistema. Ex.: A23, IMP-041.</p>
      </div>
      <div>
        <label class="label" for="status">Status</label>
        <% const isAdmin = typeof user !== 'undefined' && user && user.role === 'admin'; %>
        <% if (isAdmin) { %>
          <select class="field" id="status" name="status">
            <% statusList.forEach(function(s) { %>
              <option value="<%= s %>" <%= (pedido?.status || 'aberta') === s ? 'selected' : '' %>><%= statusPedidoLabel(s) %></option>
            <% }) %>
          </select>
        <% } else { %>
          <div class="mt-1">
            <%- include('../partials/status-pedido', { pedidoId: null, status: pedido?.status || 'aberta' }) %>
          </div>
          <input type="hidden" name="status" value="<%= pedido?.status || 'aberta' %>">
          <p class="field-hint">Somente administradores podem alterar o status.</p>
        <% } %>
      </div>
      <div class="span-2">
        <label class="label" for="fornecedor_id">Fornecedor</label>
        <select class="field" id="fornecedor_id" name="fornecedor_id" required>
          <option value="">Selecione um fornecedor…</option>
          <% (typeof fornecedores !== 'undefined' ? fornecedores : []).forEach(function(f) { %>
            <option
              value="<%= f.id %>"
              <%= String(pedido?.fornecedor_id || '') === String(f.id) ? 'selected' : '' %>
            >
              <%= f.nome %><%= f.pais ? ' · ' + f.pais : '' %><%= f.ativo ? '' : ' (inativo)' %>
            </option>
          <% }) %>
        </select>
        <p class="field-hint">
          Cadastre em
          <a class="link-action" href="/fornecedores/novo">Fornecedores</a>
          se ainda não existir.
        </p>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h2 class="form-section-title">Prazos</h2>
    <div class="form-grid form-grid-2">
      <div>
        <label class="label" for="data_inicio_fabricacao_br">Início da fabricação</label>
        <div class="date-br">
          <input
            class="field"
            type="text"
            id="data_inicio_fabricacao_br"
            inputmode="numeric"
            placeholder="dd/mm/aaaa"
            maxlength="10"
            autocomplete="off"
            value="<%= pedido?.data_inicio_fabricacao ? formatDateBr(pedido.data_inicio_fabricacao) : '' %>"
          >
          <span class="date-br-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <path d="M16 2v4M8 2v4M3 10h18"/>
            </svg>
          </span>
          <input
            class="date-br-native"
            type="date"
            id="data_inicio_fabricacao"
            name="data_inicio_fabricacao"
            value="<%= pedido?.data_inicio_fabricacao || '' %>"
            aria-label="Abrir calendário"
            tabindex="-1"
          >
        </div>
        <p class="field-hint">Base para a data prevista de chegada.</p>
      </div>
      <div>
        <label class="label" for="data_prevista_chegada_br">Prevista de chegada</label>
        <input
          class="field"
          type="text"
          id="data_prevista_chegada_br"
          value="<%= pedido?.data_prevista_chegada ? formatDateBr(pedido.data_prevista_chegada) : '' %>"
          placeholder="dd/mm/aaaa"
          readonly
          tabindex="-1"
        >
        <p class="field-hint">Calculada automaticamente: início + 90 dias.</p>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h2 class="form-section-title">Observações</h2>
    <div>
      <label class="label" for="observacao">Notas internas</label>
      <textarea class="field" id="observacao" name="observacao" rows="4" placeholder="Condições, referências de invoice, contatos…"><%= pedido?.observacao || '' %></textarea>
    </div>
  </div>

  <div class="form-actions">
    <a href="/pedidos" class="btn btn-ghost">Cancelar</a>
    <button type="submit" class="btn btn-primary"><%= pedido && pedido.id ? 'Salvar alterações' : 'Criar pedido' %></button>
  </div>
</form>

<script>
(function () {
  var inicioBr = document.getElementById('data_inicio_fabricacao_br');
  var inicioIso = document.getElementById('data_inicio_fabricacao');
  var previstaBr = document.getElementById('data_prevista_chegada_br');
  if (!inicioBr || !inicioIso || !previstaBr) return;

  function pad2(n) {
    return String(n).padStart(2, '0');
  }

  function isoToBr(iso) {
    if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return '';
    var parts = iso.split('-');
    return parts[2] + '/' + parts[1] + '/' + parts[0];
  }

  function brToIso(br) {
    var m = String(br || '').trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!m) return '';
    var day = Number(m[1]);
    var month = Number(m[2]);
    var year = Number(m[3]);
    if (month < 1 || month > 12 || day < 1 || day > 31) return '';
    var dt = new Date(Date.UTC(year, month - 1, day));
    if (dt.getUTCFullYear() !== year || dt.getUTCMonth() !== month - 1 || dt.getUTCDate() !== day) return '';
    return year + '-' + pad2(month) + '-' + pad2(day);
  }

  function maskBrDate(raw) {
    var digits = String(raw || '').replace(/\D/g, '').slice(0, 8);
    if (digits.length <= 2) return digits;
    if (digits.length <= 4) return digits.slice(0, 2) + '/' + digits.slice(2);
    return digits.slice(0, 2) + '/' + digits.slice(2, 4) + '/' + digits.slice(4);
  }

  function addDaysIso(dateStr, days) {
    if (!dateStr) return '';
    var parts = dateStr.split('-').map(Number);
    if (parts.length < 3 || !parts[0] || !parts[1] || !parts[2]) return '';
    var dt = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));
    dt.setUTCDate(dt.getUTCDate() + days);
    return dt.toISOString().slice(0, 10);
  }

  function syncPrevista(iso) {
    var chegada = iso ? addDaysIso(iso, 90) : '';
    previstaBr.value = isoToBr(chegada);
  }

  function applyIso(iso) {
    inicioIso.value = iso || '';
    if (iso) inicioBr.value = isoToBr(iso);
    syncPrevista(iso);
  }

  inicioBr.addEventListener('input', function () {
    inicioBr.value = maskBrDate(inicioBr.value);
    var iso = brToIso(inicioBr.value);
    inicioIso.value = iso;
    syncPrevista(iso);
  });

  inicioBr.addEventListener('blur', function () {
    var iso = brToIso(inicioBr.value);
    if (iso) {
      applyIso(iso);
      return;
    }
    if (!inicioBr.value.trim()) {
      applyIso('');
      return;
    }
    inicioIso.value = '';
    syncPrevista('');
  });

  inicioIso.addEventListener('change', function () {
    applyIso(inicioIso.value || '');
  });
})();
</script>

<%- include('../partials/footer') %>
