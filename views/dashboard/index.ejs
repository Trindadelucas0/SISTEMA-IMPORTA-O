<%- include('../partials/header') %>

<%
  function fxNum(v, digits) {
    if (v == null || !Number.isFinite(Number(v))) return '—';
    return numberBr(v, digits == null ? 4 : digits);
  }
  function fxChgClass(pct) {
    if (pct == null || !Number.isFinite(Number(pct))) return 'fx-chg-flat';
    if (Number(pct) > 0) return 'fx-chg-up';
    if (Number(pct) < 0) return 'fx-chg-down';
    return 'fx-chg-flat';
  }
  function fxChgText(pct) {
    if (pct == null || !Number.isFinite(Number(pct))) return 'sem variação';
    const n = Number(pct);
    const sign = n > 0 ? '+' : '';
    return sign + numberBr(n, 2) + '%';
  }
  const c = typeof cotacoes !== 'undefined' && cotacoes ? cotacoes : { ok: false, comercial: null, turismo: null, ptax: null, historico: [] };
  const comercial = c.comercial;
  const turismo = c.turismo;
  const ptax = c.ptax;
  const histBids = (c.historico || []).map(function (h) { return h.bid; });
  const histLabels = (c.historico || []).map(function (h, i) {
    if (h.createDate) {
      const d = new Date(h.createDate.replace(' ', 'T'));
      if (!isNaN(d.getTime())) return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
    }
    return String(i + 1);
  });
  const atualizado = c.updatedAt
    ? new Date(c.updatedAt).toLocaleString('pt-BR')
    : null;

  const saldoSafe = (typeof saldo !== 'undefined' && saldo) ? saldo : {
    disponivel_usd: 0,
    disponivel_brl: 0,
    alocado_usd: 0,
    alocado_brl: 0,
    total_usd: 0,
    total_brl: 0,
  };
  const kpiSafe = (typeof kpi !== 'undefined' && kpi) ? kpi : {
    qtdAbertos: 0,
    qtdCobertos: 0,
    qtdCriticos: 0,
    invoiceTotalUsd: 0,
    faltaTotalUsd: 0,
    coberturaMedia: 0,
    utilizacaoPct: 0,
    ticketMedioUsd: 0,
    ptaxAsk: null,
    ptaxPct: null,
  };
  const coberturasSafe = (typeof coberturas !== 'undefined' && Array.isArray(coberturas)) ? coberturas : [];
  const statusLabelsSafe = (typeof statusLabels !== 'undefined' && Array.isArray(statusLabels)) ? statusLabels : [];
  const statusValuesSafe = (typeof statusValues !== 'undefined' && Array.isArray(statusValues)) ? statusValues : [];
  const pagamentosSerieSafe = (typeof pagamentosSerie !== 'undefined' && pagamentosSerie) ? pagamentosSerie : { labels: [], usd: [], brl: [] };
  const coberturaChartSafe = (typeof coberturaChart !== 'undefined' && coberturaChart) ? coberturaChart : { labels: [], alocado: [], falta: [] };
  const hasPagamentosSerie = (pagamentosSerieSafe.usd || []).some(function (v) { return Number(v) > 0; });
  const hasCoberturaChart = (coberturaChartSafe.labels || []).length > 0;
%>

<section class="page-header flex flex-wrap items-end justify-between gap-3 dash-reveal">
  <div>
    <p class="page-eyebrow">Operação</p>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-sub">Caixa, cobertura de pedidos e câmbio USD/BRL em tempo real.</p>
  </div>
  <div class="toolbar">
    <a href="/pagamentos/novo" class="btn btn-ghost">Novo pagamento</a>
    <a href="/pedidos/novo" class="btn btn-primary">Novo pedido</a>
  </div>
</section>

<section class="fx-panel mb-4 dash-reveal dash-reveal-d1">
  <div class="panel-head">
    <h2>Câmbio USD / BRL</h2>
    <div class="fx-meta text-right">
      <% if (c.ok === false && c.error) { %>
        Indisponível agora
      <% } else { %>
        Atualizado <%= atualizado || '—' %><% if (c.stale) { %> · cache<% } %>
      <% } %>
    </div>
  </div>
  <div class="panel-body">
    <% if (c.ok === false && !comercial && !ptax) { %>
      <p class="empty-state" style="background:rgba(255,255,255,0.04);border-color:rgba(148,163,184,0.3);color:#CBD5E1">
        Não foi possível carregar cotações. <%= c.error || '' %>
      </p>
    <% } else { %>
      <div class="fx-layout">
        <div>
          <div class="fx-grid mb-3">
            <div class="fx-card">
              <p class="fx-card-label">Comercial · venda</p>
              <p class="fx-card-value"><%= fxNum(comercial && comercial.ask) %></p>
              <p class="fx-card-sub">compra <%= fxNum(comercial && comercial.bid) %></p>
              <p class="fx-chg <%= fxChgClass(comercial && comercial.pctChange) %>"><%= fxChgText(comercial && comercial.pctChange) %></p>
            </div>
            <div class="fx-card">
              <p class="fx-card-label">PTAX · referência BCB</p>
              <p class="fx-card-value"><%= fxNum(ptax && ptax.ask) %></p>
              <p class="fx-card-sub">compra <%= fxNum(ptax && ptax.bid) %></p>
              <p class="fx-chg <%= fxChgClass(ptax && ptax.pctChange) %>"><%= fxChgText(ptax && ptax.pctChange) %></p>
            </div>
            <div class="fx-card">
              <p class="fx-card-label">Turismo · venda</p>
              <p class="fx-card-value"><%= fxNum(turismo && turismo.ask) %></p>
              <p class="fx-card-sub">compra <%= fxNum(turismo && turismo.bid) %></p>
              <p class="fx-chg <%= fxChgClass(turismo && turismo.pctChange) %>"><%= fxChgText(turismo && turismo.pctChange) %></p>
            </div>
            <div class="fx-card">
              <p class="fx-card-label">Amplitude do dia</p>
              <p class="fx-card-value"><%= fxNum(comercial && comercial.high) %></p>
              <p class="fx-card-sub">mín <%= fxNum(comercial && comercial.low) %></p>
              <p class="fx-card-sub" style="margin-top:0.45rem;font-family:inherit;letter-spacing:0">
                Futuro BM&amp;F: consulte B3 / corretora
              </p>
            </div>
          </div>
          <p class="fx-meta">Fonte: <%= c.source || 'mercado' %>. PTAX oficial do dia; comercial e turismo são referências de mercado (não são cotação de contrato futuro).</p>
        </div>
        <div class="fx-chart-wrap">
          <p class="fx-card-label" style="margin-bottom:0.4rem">Tendência · últimos pregões (compra)</p>
          <% if (histBids.length > 1) { %>
            <div class="chart-box">
              <canvas id="chartFx" aria-label="Histórico do dólar"></canvas>
            </div>
          <% } else { %>
            <p class="fx-meta" style="padding:1rem 0">Histórico indisponível no momento.</p>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<section class="kpi-grid mb-4">
  <div class="stat dash-reveal dash-reveal-d1">
    <p class="stat-label">Saldo disponível USD</p>
    <p class="stat-value" data-count="<%= Number(saldoSafe.disponivel_usd) || 0 %>" data-format="usd"><%= moneyUsd(saldoSafe.disponivel_usd) %></p>
    <p class="stat-meta"><%= moneyBrl(saldoSafe.disponivel_brl) %> · alocado <%= moneyUsd(saldoSafe.alocado_usd) %></p>
  </div>
  <div class="stat dash-reveal dash-reveal-d2">
    <p class="stat-label">Pedidos abertos</p>
    <p class="stat-value" data-count="<%= Number(kpiSafe.qtdAbertos) || 0 %>" data-format="int"><%= kpiSafe.qtdAbertos %></p>
    <p class="stat-meta"><%= kpiSafe.qtdCobertos %> cobertos · média <%= numberBr(kpiSafe.coberturaMedia, 1) %>%</p>
  </div>
  <div class="stat dash-reveal dash-reveal-d3">
    <p class="stat-label">Falta a cobrir USD</p>
    <p class="stat-value <%= kpiSafe.faltaTotalUsd > 0 ? 'text-bad' : 'text-ok' %>" data-count="<%= Number(kpiSafe.faltaTotalUsd) || 0 %>" data-format="usd"><%= moneyUsd(kpiSafe.faltaTotalUsd) %></p>
    <p class="stat-meta"><%= qtdPedidos %> pedidos no total</p>
  </div>
  <div class="stat dash-reveal dash-reveal-d4">
    <p class="stat-label">Invoice total USD</p>
    <p class="stat-value" data-count="<%= Number(kpiSafe.invoiceTotalUsd) || 0 %>" data-format="usd"><%= moneyUsd(kpiSafe.invoiceTotalUsd) %></p>
  </div>
  <div class="stat dash-reveal dash-reveal-d5">
    <p class="stat-label">Utilização do pool</p>
    <p class="stat-value" data-count="<%= Number(kpiSafe.utilizacaoPct) || 0 %>" data-format="pct"><%= numberBr(kpiSafe.utilizacaoPct, 1) %>%</p>
    <p class="stat-meta">alocado <%= moneyUsd(saldoSafe.alocado_usd) %> de <%= moneyUsd(saldoSafe.total_usd) %></p>
  </div>
  <div class="stat dash-reveal dash-reveal-d6">
    <p class="stat-label">Pedidos críticos</p>
    <p class="stat-value <%= kpiSafe.qtdCriticos > 0 ? 'text-bad' : 'text-ok' %>" data-count="<%= Number(kpiSafe.qtdCriticos) || 0 %>" data-format="int"><%= kpiSafe.qtdCriticos %></p>
    <p class="stat-meta">abertos com falta &gt; 0</p>
  </div>
  <div class="stat dash-reveal dash-reveal-d7">
    <p class="stat-label">Total pago BRL</p>
    <p class="stat-value" data-count="<%= Number(totalBrl) || 0 %>" data-format="brl"><%= moneyBrl(totalBrl) %></p>
    <p class="stat-meta"><%= qtdPagamentos %> pagamentos · ticket méd. <%= moneyUsd(kpiSafe.ticketMedioUsd) %></p>
  </div>
</section>

<section class="dash-grid-3 mb-4">
  <div class="panel dash-reveal dash-reveal-d3">
    <div class="panel-head">
      <h2>Saldo do pool (USD)</h2>
      <a href="/saldo" class="link-action text-sm">Abrir saldo</a>
    </div>
    <div class="panel-body">
      <div class="chart-box chart-box-donut">
        <div class="chart-donut-wrap">
          <canvas id="chartSaldo" aria-label="Gráfico do saldo"></canvas>
          <div class="chart-donut-center">
            <span class="donut-label">Total</span>
            <span class="donut-value"><%= moneyUsd(saldoSafe.total_usd) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="panel dash-reveal dash-reveal-d4">
    <div class="panel-head">
      <h2>Pedidos por status</h2>
    </div>
    <div class="panel-body">
      <% if (!statusLabelsSafe.length) { %>
        <p class="empty-state">Sem pedidos para agregar.</p>
      <% } else { %>
        <div class="chart-box chart-box-sm">
          <canvas id="chartStatus" aria-label="Gráfico de status"></canvas>
        </div>
      <% } %>
    </div>
  </div>
  <div class="panel dash-reveal dash-reveal-d5">
    <div class="panel-head">
      <h2>Pagamentos (6 meses)</h2>
      <a href="/pagamentos" class="link-action text-sm">Ver todos</a>
    </div>
    <div class="panel-body">
      <% if (!hasPagamentosSerie) { %>
        <p class="empty-state">Sem pagamentos nos últimos meses.</p>
      <% } else { %>
        <div class="chart-box chart-box-sm">
          <canvas id="chartPagamentos" aria-label="Pagamentos por mês"></canvas>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="dash-grid mb-4">
  <div class="panel dash-reveal dash-reveal-d6">
    <div class="panel-head">
      <h2>Cobertura alocado × falta</h2>
    </div>
    <div class="panel-body">
      <% if (!hasCoberturaChart) { %>
        <p class="empty-state">Nenhum pedido cadastrado ainda.</p>
      <% } else { %>
        <div class="chart-box">
          <canvas id="chartCobertura" aria-label="Cobertura alocado versus falta"></canvas>
        </div>
      <% } %>
    </div>
  </div>
  <div class="panel dash-reveal dash-reveal-d7">
    <div class="panel-head">
      <h2>Cobertura por pedido</h2>
    </div>
    <div class="panel-body">
      <% if (!coberturasSafe.length) { %>
        <p class="empty-state">Nenhum pedido cadastrado ainda.</p>
      <% } else { %>
        <div class="bar-list">
          <% coberturasSafe.forEach(function(cov) { %>
            <div class="bar-row">
              <a class="code link-action" href="/pedidos/<%= cov.id %>"><%= cov.codigo %></a>
              <div
                class="progress progress-animate <%= cov.coberto ? 'progress-ok' : (cov.pct > 0 ? 'progress-warn' : '') %>"
                style="--pct: <%= cov.pct %>%"
                title="<%= cov.pct %>%"
              >
                <span></span>
              </div>
              <div class="val"><%= cov.pct %>% · <%= moneyUsd(cov.falta_usd) %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="panel dash-reveal dash-reveal-d8">
  <div class="panel-head">
    <h2>Pedidos recentes</h2>
    <a href="/pedidos" class="link-action text-sm">Ver todos</a>
  </div>
  <% if (!pedidos.length) { %>
    <div class="panel-body"><p class="empty-state">Nenhum pedido cadastrado ainda.</p></div>
  <% } else { %>
    <div class="table-panel" style="border:0;border-radius:0">
      <table>
        <thead>
          <tr>
            <th>Código</th>
            <th>Status</th>
            <th class="col-hide-sm">Itens</th>
            <th>Invoice USD</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% pedidos.forEach(function(p) { %>
            <tr>
              <td class="font-semibold"><%= p.codigo %></td>
              <td><%- include('../partials/status-pedido', { pedidoId: p.id, status: p.status }) %></td>
              <td class="num col-hide-sm"><%= p.qtd_itens %></td>
              <td class="num"><%= moneyUsd(p.total_usd) %></td>
              <td class="text-right">
                <a href="/pedidos/<%= p.id %>" class="link-action">Abrir</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var chartAnim = reduceMotion
    ? { duration: 0 }
    : { duration: 800, easing: 'easeOutQuart' };

  function moneyUsdFmt(v) {
    return 'US$ ' + Number(v || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function formatCount(value, format) {
    if (format === 'usd') {
      return Number(value).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
    }
    if (format === 'brl') {
      return Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }
    if (format === 'pct') {
      return Number(value).toLocaleString('pt-BR', {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1
      }) + '%';
    }
    return String(Math.round(value));
  }

  function countUp(el) {
    if (!el || reduceMotion) return;
    var target = Number(el.getAttribute('data-count'));
    if (!Number.isFinite(target)) return;
    var format = el.getAttribute('data-format') || 'int';
    var duration = 600;
    var start = performance.now();

    function frame(now) {
      var t = Math.min(1, (now - start) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      el.textContent = formatCount(target * eased, format);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  document.querySelectorAll('[data-count]').forEach(countUp);

  requestAnimationFrame(function () {
    document.querySelectorAll('.progress-animate').forEach(function (el) {
      el.classList.add('is-ready');
    });
  });

  if (!window.Chart) return;

  var statusColorMap = {
    'Aberta': '#1B4F9C',
    'Em Trânsito': '#F59E0B',
    'Embarcada': '#0F766E',
    'Finalizada': '#94A3B8'
  };
  var statusFallback = ['#1B4F9C', '#3B82F6', '#0F766E', '#F59E0B', '#94A3B8', '#64748B'];

  var disponivel = <%= Number(saldoSafe.disponivel_usd) || 0 %>;
  var alocado = <%= Number(saldoSafe.alocado_usd) || 0 %>;
  var ctxSaldo = document.getElementById('chartSaldo');
  if (ctxSaldo) {
    new Chart(ctxSaldo, {
      type: 'doughnut',
      data: {
        labels: ['Disponível', 'Alocado'],
        datasets: [{
          data: [disponivel, alocado],
          backgroundColor: ['#1B4F9C', '#94A3B8'],
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '72%',
        animation: chartAnim,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 10, font: { family: 'IBM Plex Sans', size: 12 } }
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + ctx.label + ': ' + moneyUsdFmt(ctx.parsed || 0);
              }
            }
          }
        }
      }
    });
  }

  var statusLabels = <%- JSON.stringify(statusLabelsSafe) %>;
  var statusValues = <%- JSON.stringify(statusValuesSafe) %>;
  var ctxStatus = document.getElementById('chartStatus');
  if (ctxStatus && statusLabels.length) {
    var statusColors = statusLabels.map(function (label, i) {
      return statusColorMap[label] || statusFallback[i % statusFallback.length];
    });
    new Chart(ctxStatus, {
      type: 'bar',
      data: {
        labels: statusLabels,
        datasets: [{
          label: 'Pedidos',
          data: statusValues,
          backgroundColor: statusColors,
          borderRadius: 2,
          maxBarThickness: 36
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: chartAnim,
        plugins: { legend: { display: false } },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { family: 'IBM Plex Sans', size: 11 } }
          },
          y: {
            beginAtZero: true,
            ticks: { precision: 0, font: { family: 'IBM Plex Sans', size: 11 } },
            grid: { color: '#ECEEF2' }
          }
        }
      }
    });
  }

  var pagLabels = <%- JSON.stringify(pagamentosSerieSafe.labels || []) %>;
  var pagUsd = <%- JSON.stringify(pagamentosSerieSafe.usd || []) %>;
  var ctxPag = document.getElementById('chartPagamentos');
  if (ctxPag && pagLabels.length) {
    new Chart(ctxPag, {
      type: 'bar',
      data: {
        labels: pagLabels,
        datasets: [{
          label: 'USD',
          data: pagUsd,
          backgroundColor: '#1B4F9C',
          borderRadius: 2,
          maxBarThickness: 28
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: chartAnim,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + moneyUsdFmt(ctx.parsed.y || 0);
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { family: 'IBM Plex Sans', size: 10 } }
          },
          y: {
            beginAtZero: true,
            grid: { color: '#ECEEF2' },
            ticks: { font: { family: 'IBM Plex Sans', size: 10 } }
          }
        }
      }
    });
  }

  var cobLabels = <%- JSON.stringify(coberturaChartSafe.labels || []) %>;
  var cobAlocado = <%- JSON.stringify(coberturaChartSafe.alocado || []) %>;
  var cobFalta = <%- JSON.stringify(coberturaChartSafe.falta || []) %>;
  var ctxCob = document.getElementById('chartCobertura');
  if (ctxCob && cobLabels.length) {
    new Chart(ctxCob, {
      type: 'bar',
      data: {
        labels: cobLabels,
        datasets: [
          {
            label: 'Alocado',
            data: cobAlocado,
            backgroundColor: '#1B4F9C',
            borderRadius: 2,
            maxBarThickness: 22
          },
          {
            label: 'Falta',
            data: cobFalta,
            backgroundColor: '#FDB022',
            borderRadius: 2,
            maxBarThickness: 22
          }
        ]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        animation: chartAnim,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 10, font: { family: 'IBM Plex Sans', size: 11 } }
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ' ' + ctx.dataset.label + ': ' + moneyUsdFmt(ctx.parsed.x || 0);
              }
            }
          }
        },
        scales: {
          x: {
            stacked: true,
            beginAtZero: true,
            grid: { color: '#ECEEF2' },
            ticks: { font: { family: 'IBM Plex Sans', size: 10 } }
          },
          y: {
            stacked: true,
            grid: { display: false },
            ticks: { font: { family: 'IBM Plex Sans', size: 11 } }
          }
        }
      }
    });
  }

  var fxLabels = <%- JSON.stringify(histLabels) %>;
  var fxBids = <%- JSON.stringify(histBids) %>;
  var ctxFx = document.getElementById('chartFx');
  if (ctxFx && fxBids.length > 1) {
    new Chart(ctxFx, {
      type: 'line',
      data: {
        labels: fxLabels,
        datasets: [{
          label: 'USD compra',
          data: fxBids,
          borderColor: '#93C5FD',
          backgroundColor: 'rgba(147, 197, 253, 0.15)',
          fill: true,
          tension: 0.35,
          pointRadius: 2,
          pointHoverRadius: 4,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: chartAnim,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                var v = ctx.parsed.y || 0;
                return ' R$ ' + v.toLocaleString('pt-BR', {
                  minimumFractionDigits: 4,
                  maximumFractionDigits: 4
                });
              }
            }
          }
        },
        scales: {
          x: {
            grid: { color: 'rgba(148,163,184,0.15)' },
            ticks: { color: '#94A3B8', font: { family: 'IBM Plex Sans', size: 10 }, maxRotation: 0 }
          },
          y: {
            grid: { color: 'rgba(148,163,184,0.15)' },
            ticks: {
              color: '#94A3B8',
              font: { family: 'IBM Plex Mono', size: 10 },
              callback: function (v) { return Number(v).toFixed(2); }
            }
          }
        }
      }
    });
  }
})();
</script>

<%- include('../partials/footer') %>
