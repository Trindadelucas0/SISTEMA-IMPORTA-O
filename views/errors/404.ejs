<%- include('../partials/header') %>
<section class="py-16 text-center">
  <h1 class="page-title"><%= typeof title !== 'undefined' ? title : 'Página não encontrada' %></h1>
  <p class="page-sub">
    <%= typeof message !== 'undefined' && message
      ? message
      : 'Esse endereço não existe ou o registro foi removido.' %>
  </p>
  <% if (typeof pathTried !== 'undefined' && pathTried) { %>
    <p class="mono mt-2 text-sm" style="color:var(--muted)"><%= pathTried %></p>
  <% } %>
  <div class="mt-6 flex flex-wrap justify-center gap-2">
    <a href="/" class="btn btn-primary">Dashboard</a>
    <a href="/pedidos" class="btn btn-ghost">Pedidos</a>
    <a href="/saldo" class="btn btn-ghost">Saldo</a>
  </div>
</section>
<%- include('../partials/footer') %>
