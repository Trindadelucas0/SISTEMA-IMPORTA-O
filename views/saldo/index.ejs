<%- include('../partials/header') %>

<section class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="brand text-3xl font-bold">Saldo</h1>
    <p class="mt-1 text-[#4a5560]">Pool único. Pedidos consomem por alocação (FIFO ou manual).</p>
  </div>
  <form method="POST" action="/saldo/fifo">
    <button type="submit" class="btn btn-primary">Alocar FIFO</button>
  </form>
</section>

<% if (message) { %>
  <p class="mb-4 rounded border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"><%= message %></p>
<% } %>
<% if (error) { %>
  <p class="mb-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800"><%= error %></p>
<% } %>

<section class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg border border-[#d4cfc3] bg-white/70 p-4">
    <p class="text-sm text-[#4a5560]">Disponível USD</p>
    <p class="text-xl font-bold"><%= moneyUsd(saldo.disponivel_usd) %></p>
  </div>
  <div class="rounded-lg border border-[#d4cfc3] bg-white/70 p-4">
    <p class="text-sm text-[#4a5560]">Disponível BRL</p>
    <p class="text-xl font-bold"><%= moneyBrl(saldo.disponivel_brl) %></p>
  </div>
  <div class="rounded-lg border border-[#d4cfc3] bg-white/70 p-4">
    <p class="text-sm text-[#4a5560]">Já alocado USD</p>
    <p class="text-xl font-bold"><%= moneyUsd(saldo.alocado_usd) %></p>
  </div>
  <div class="rounded-lg border border-[#d4cfc3] bg-white/70 p-4">
    <p class="text-sm text-[#4a5560]">Já alocado BRL</p>
    <p class="text-xl font-bold"><%= moneyBrl(saldo.alocado_brl) %></p>
  </div>
</section>

<section class="mb-8">
  <h2 class="mb-3 text-lg font-semibold">Falta por pedido</h2>
  <div class="overflow-x-auto rounded-lg border border-[#d4cfc3] bg-white/70">
    <table class="w-full text-left text-sm">
      <thead class="bg-[#1a2332] text-white">
        <tr>
          <th class="px-3 py-2">Pedido</th>
          <th class="px-3 py-2">Invoice</th>
          <th class="px-3 py-2">Alocado</th>
          <th class="px-3 py-2">Falta</th>
          <th class="px-3 py-2">Status</th>
        </tr>
      </thead>
      <tbody>
        <% saldosPedidos.forEach(function(p) { %>
          <tr class="border-t border-[#d4cfc3]">
            <td class="px-3 py-2 font-semibold"><a class="text-[#0f6e56] underline" href="/pedidos/<%= p.id %>"><%= p.codigo %></a></td>
            <td class="px-3 py-2"><%= moneyUsd(p.invoice_usd) %></td>
            <td class="px-3 py-2"><%= moneyUsd(p.alocado_usd) %></td>
            <td class="px-3 py-2 <%= p.falta_usd > 0 ? 'text-[#8b2e2e]' : 'text-[#0f6e56]' %>"><%= moneyUsd(p.falta_usd) %></td>
            <td class="px-3 py-2"><%= p.status_fornecedor %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="mb-8">
  <h2 class="mb-3 text-lg font-semibold">Alocação manual</h2>
  <form method="POST" action="/saldo/alocar" class="grid max-w-3xl gap-3 rounded-lg border border-[#d4cfc3] bg-white/80 p-4 sm:grid-cols-4">
    <div>
      <label class="label" for="pagamento_id">Pagamento</label>
      <select class="field" id="pagamento_id" name="pagamento_id" required>
        <option value="">Selecione</option>
        <% pagamentos.forEach(function(pg) { %>
          <option value="<%= pg.id %>">#<%= pg.id %> · <%= moneyUsd(pg.disponivel_usd) %> disp · <%= numberBr(pg.dolar_dia, 4) %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="label" for="pedido_id">Pedido</label>
      <select class="field" id="pedido_id" name="pedido_id" required>
        <option value="">Selecione</option>
        <% pedidos.forEach(function(p) { %>
          <option value="<%= p.id %>"><%= p.codigo %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="label" for="valor_usd">USD a alocar</label>
      <input class="field" type="number" step="any" id="valor_usd" name="valor_usd" required>
    </div>
    <div class="flex items-end">
      <button type="submit" class="btn btn-primary w-full">Alocar</button>
    </div>
  </form>
</section>

<section class="mb-8">
  <h2 class="mb-3 text-lg font-semibold">Alocações</h2>
  <% if (!alocacoes.length) { %>
    <p class="text-sm text-[#4a5560]">Nenhuma alocação ainda.</p>
  <% } else { %>
    <div class="overflow-x-auto rounded-lg border border-[#d4cfc3] bg-white/70">
      <table class="w-full text-left text-sm">
        <thead class="bg-[#1a2332] text-white">
          <tr>
            <th class="px-3 py-2">Pedido</th>
            <th class="px-3 py-2">Pagamento</th>
            <th class="px-3 py-2">USD</th>
            <th class="px-3 py-2">Dólar</th>
            <th class="px-3 py-2">BRL</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% alocacoes.forEach(function(a) { %>
            <tr class="border-t border-[#d4cfc3]">
              <td class="px-3 py-2"><%= a.pedido_codigo %></td>
              <td class="px-3 py-2">#<%= a.pagamento_id %> · <%= a.pagamento_descricao %></td>
              <td class="px-3 py-2"><%= moneyUsd(a.valor_usd) %></td>
              <td class="px-3 py-2"><%= numberBr(a.dolar_dia, 4) %></td>
              <td class="px-3 py-2"><%= moneyBrl(a.valor_brl) %></td>
              <td class="px-3 py-2 text-right">
                <form method="POST" action="/saldo/alocacoes/<%= a.id %>?_method=DELETE" onsubmit="return confirm('Remover alocação?')">
                  <button type="submit" class="text-red-700 underline">Remover</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section>
  <h2 class="mb-3 text-lg font-semibold">Extrato</h2>
  <div class="overflow-x-auto rounded-lg border border-[#d4cfc3] bg-white/70">
    <table class="w-full text-left text-sm">
      <thead class="bg-[#1a2332] text-white">
        <tr>
          <th class="px-3 py-2">Data</th>
          <th class="px-3 py-2">Descrição</th>
          <th class="px-3 py-2">Mov. USD</th>
          <th class="px-3 py-2">Mov. BRL</th>
          <th class="px-3 py-2">Saldo USD</th>
          <th class="px-3 py-2">Saldo BRL</th>
        </tr>
      </thead>
      <tbody>
        <% extrato.forEach(function(linha) { %>
          <tr class="border-t border-[#d4cfc3]">
            <td class="px-3 py-2"><%= linha.data ? new Date(linha.data).toLocaleDateString('pt-BR') : '—' %></td>
            <td class="px-3 py-2"><%= linha.descricao %></td>
            <td class="px-3 py-2 <%= linha.movimento_usd < 0 ? 'text-[#8b2e2e]' : 'text-[#0f6e56]' %>"><%= moneyUsd(linha.movimento_usd) %></td>
            <td class="px-3 py-2"><%= moneyBrl(linha.movimento_brl) %></td>
            <td class="px-3 py-2"><%= moneyUsd(linha.saldo_usd) %></td>
            <td class="px-3 py-2"><%= moneyBrl(linha.saldo_brl) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
